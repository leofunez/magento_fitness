<?php
/** @var \Custom\MoreChoices\Block\MoreChoices $block */

$_productCollection = $block->getProducts();

if (count($_productCollection) > 0): ?>
<section class="section__content">
    <div class="block__card-list">
        <h2 class="block__title">
            <?= __('More Choices') ?>
        </h2>

        <div class="product-list">
            <?php foreach ($_productCollection as $_product): ?>
                <?php
                    $_id = $_product->getId();
                    $_productCard = $block->getProductCard($_id);

                    if($_productCard): ?>
                        <?= $_productCard; ?>
                    <?php endif;
                ?>
            <?php endforeach; ?>
        </div>
    </div>
</section>
<?php endif; ?>
